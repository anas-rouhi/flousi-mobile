# Host (or full API root) the mobile app talks to. Expo inlines EXPO_PUBLIC_*
# variables at bundle time, so restart the dev server after changing this.
# Use your machine's LAN IP — "localhost" does not resolve from a device.
# In dev builds you can also change it from the phone (Settings → Developer
# settings, or the prompt shown when the server is unreachable); that override
# wins over this value until you reset it.
EXPO_PUBLIC_API_URL=http://192.168.100.240:8000
